# Optional: WebSocket URL for production builds (no trailing slash).
# In development, the CRA proxy uses /pointy-ws → localhost:3333.
# Production (Cloudflare Pages build env):
# REACT_APP_POINTING_BLACKJACK_WS=wss://ws.pointy.website

# Optional: fallback port when REACT_APP_POINTING_BLACKJACK_WS is unset (non-dev).
# REACT_APP_POINTING_BLACKJACK_PORT=3333

# Required for the WebSocket server (session persistence).
# Run supabase/migrations/*.sql in your project first
# (including 20260831000000_pointing_anonymous_mode.sql).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Pages function `functions/submit-feedback.ts` (feedback modal).
# RESEND_API_KEY=
# FEEDBACK_EMAIL_FROM=
# FEEDBACK_EMAIL_TO=
# Bridge to this host (creates a Vikunja task; v.tyler.cloud is behind Authentik):
# FEEDBACK_VIKUNJA_PROXY_URL=https://ws.pointy.website/create-pointy-feedback
# FEEDBACK_TAIGA_PROXY_URL is the previous name and still works.
# POINTY_FEEDBACK_SECRET=generate-a-long-random-string

# WebSocket host: same POINTY_FEEDBACK_SECRET as Pages. Vikunja creds default from Cabinet
# (vikunja.api_root, vikunja.api_token, vikunja.base_url) when unset.
# Session summary mail uses the same Resend account and addresses as Pointy feedback.
# RESEND_API_KEY falls back to Cabinet keys.resend.token.
# FEEDBACK_EMAIL_FROM / FEEDBACK_EMAIL_TO fall back to Cabinet
# pointy.feedback_email_from / pointy.feedback_email_to.
# POINTY_FEEDBACK_SECRET=
# VIKUNJA_API_ROOT=http://127.0.0.1:3456/api/v1
# VIKUNJA_API_TOKEN=
# VIKUNJA_BASE_URL=https://v.tyler.cloud
